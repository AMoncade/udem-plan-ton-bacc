{
  "name": "udem-plan-ton-bacc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "scrape": "node --experimental-strip-types scripts/scrape/index.ts",
    "donnees:copier": "node scripts/copier-donnees.mjs",
    "prebuild": "node scripts/copier-donnees.mjs",
    "predev": "node scripts/copier-donnees.mjs",
    "desktop:export": "next build",
    "desktop:lancer": "electron electron/main.cjs",
    "desktop:verifier": "electron electron/main.cjs --verifier",
    "desktop:paquet": "electron-builder --config electron/builder.yml --dir",
    "desktop:installateur": "electron-builder --config electron/builder.yml --win",
    "desktop:build": "npm run desktop:export && npm run desktop:installateur"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
